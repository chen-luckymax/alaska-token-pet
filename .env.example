# 复制为 .env，填自己的值；不要把 .env 提交到 Git。
# 任意 OpenAI 兼容服务都可以：OpenAI / DeepSeek / 通义千问 / Moonshot / OpenRouter / 火山方舟等。
# OpenCSG AI Gateway 示例：LLM_API_URL=https://openeast.opencsg.com/aigateway/v1/chat/completions
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# 不想用远程模型时，清空上面三项，启动本机 Ollama 即可自动兜底：
# ollama serve
# ollama pull llama3.2
# 本地默认地址：http://127.0.0.1:11434/v1
